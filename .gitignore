# IDE and operating-system files
.idea/
.vscode/
*.user
*.suo
.DS_Store

# Local Codex, emulator, and build-tool workspaces
.android_home/
.codex-tmp/
.codex_tmp/
.c_drive_cache_backup/
.gradle_home/
.nuget_packages/
.superpowers/
.tmp/
**/.tmp/

# Local configuration and secrets
.env
.env.*
!.env.example

# .NET build output
**/bin/
**/obj/
TestResults/

