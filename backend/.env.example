# Copy this file to .env and replace both example values before starting Docker.
MSSQL_SA_PASSWORD=replace-with-a-strong-development-password
MSSQL_PORT=1433
REDIS_PASSWORD=replace-with-a-strong-development-password
REDIS_PORT=6379
MARKET_FEED_INGEST_KEY=replace-with-at-least-32-random-characters
MARKET_FEED_STALE_AFTER_SECONDS=5
MARKET_API_PORT=5150
